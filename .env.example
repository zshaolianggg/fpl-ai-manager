# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
OPENAI_WEB_SEARCH=true

# Email: generic SMTP (works with Gmail App Password, SES SMTP, Mailgun SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# Optional runtime overrides
FPL_TEAM_ID=6000549
FPL_TIMEZONE=Asia/Singapore
DRY_RUN=false
FORCE_REPORT=
